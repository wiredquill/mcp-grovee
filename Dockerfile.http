# Use SUSE BCI Python 3.11 as base image
FROM registry.suse.com/bci/python:3.11

# Set working directory
WORKDIR /app

# Install system dependencies if needed
RUN zypper refresh && \
    zypper install -y --no-recommends \
    gcc \
    python311-devel && \
    zypper clean -a

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY src/ ./src/

# Create non-root user for security
RUN groupadd -g 1000 mcp && \
    useradd -m -u 1000 -g mcp mcp && \
    chown -R mcp:mcp /app

# Switch to non-root user
USER mcp

# Set Python path
ENV PYTHONPATH=/app

# Set transport to SSE/HTTP by default
ENV MCP_TRANSPORT=sse
ENV MCP_HOST=0.0.0.0
ENV MCP_PORT=8080

# Expose HTTP port
EXPOSE 8080

# Health check for HTTP transport
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health').read()" || exit 1

# Run the MCP server in HTTP/SSE mode
CMD ["python3", "-m", "src.server", "--sse"]
