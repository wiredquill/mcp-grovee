# Govee API Credentials
# Get your API key from: https://developer.govee.com/
GOVEE_API_KEY=your_govee_api_key_here

# Optional: Specific device address (MAC address without colons)
# Leave empty to control all devices, or specify one device
GOVEE_DEVICE_ADDRESS=

# Optional: Specific device model
# Example: H6072
GOVEE_DEVICE_MODEL=

# Local API Configuration
# IP address of your Govee lamp on the local network
# Required for scene control and direct local communication
# Example: 10.0.15.109
GOVEE_DEVICE_IP=

# MCP Transport Configuration
# Transport mode: "stdio" (default) or "sse" (for HTTP/SSE transport)
MCP_TRANSPORT=stdio

# HTTP/SSE Transport Settings (only used when MCP_TRANSPORT=sse)
# Host to bind to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
MCP_HOST=0.0.0.0

# Port to listen on
MCP_PORT=8080
